# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=replace-with-your-mongodb-atlas-connection-string
# MONGO_URL can be used instead when Railway provides it as a service reference.

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
OTP_SECRET=replace-with-a-different-long-random-secret

# MSG91 (OTP)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-template-id
MSG91_SENDER_ID=CHNAPP

# OpenAI
OPENAI_API_KEY=

# Google Sign-In server verification
GOOGLE_CLIENT_ID=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Razorpay (India Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# App Config
APP_NAME=ChinesApp
APP_VERSION=1.0.0
DEFAULT_GEMS=50
DEFAULT_STREAK=0
DAILY_GOAL_MINUTES=10

# Admin Panel
ADMIN_EMAIL=
# Prefer a bcrypt hash. Use ADMIN_PASSWORD only temporarily if a hash is unavailable.
ADMIN_PASSWORD_HASH=
