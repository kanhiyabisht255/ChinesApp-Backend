[TEMPLATE]
# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=replace-with-your-mongodb-atlas-connection-string
# MONGO_URL can be used instead when Railway provides it as a service reference.

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
OTP_SECRET=replace-with-a-different-long-random-email-code-secret

# Email verification (Resend)
RESEND_API_KEY=
EMAIL_FROM=Learn Chinese <noreply@your-domain.com>

# OpenAI
OPENAI_API_KEY=

# Google Sign-In server verification
GOOGLE_CLIENT_ID=

# Google Play Billing verification
GOOGLE_PLAY_PACKAGE_NAME=com.chinesapp.learn
# Paste the complete service-account JSON as one Railway variable, or use the base64 alternative.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
PLAY_PREMIUM_MONTHLY_ID=chinesapp_premium_monthly
PLAY_PREMIUM_YEARLY_ID=chinesapp_premium_yearly
PLAY_PREMIUM_LIFETIME_ID=chinesapp_premium_lifetime
PLAY_GEMS_100_ID=chinesapp_gems_100
PLAY_GEMS_500_ID=chinesapp_gems_500
PLAY_GEMS_1200_ID=chinesapp_gems_1200
PLAY_GEMS_3000_ID=chinesapp_gems_3000
PLAY_GEMS_8000_ID=chinesapp_gems_8000

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Razorpay (India Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# App Config
APP_NAME=Learn Chinese
APP_VERSION=1.0.0
DEFAULT_GEMS=50
DEFAULT_STREAK=0
DAILY_GOAL_MINUTES=10

# Admin Panel
ADMIN_EMAIL=
# Prefer a bcrypt hash. Use ADMIN_PASSWORD only temporarily if a hash is unavailable.
ADMIN_PASSWORD_HASH=

# Required before sensitive integration keys can be saved from the admin panel.
# Use a long random value (32+ characters) and never expose it to the mobile/admin frontend.
ADMIN_CONFIG_ENCRYPTION_KEY=
